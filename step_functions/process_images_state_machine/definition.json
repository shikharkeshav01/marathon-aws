{
  "Comment": "Process event images pipeline using Distributed Map to read image list from S3",
  "StartAt": "ListImages",
  "States": {
    "ListImages": {
      "Type": "Task",
      "Resource": "${LIST_IMAGES_HANDLER_ARN}",
      "Next": "ChooseProcessingMode"
    },
    "ChooseProcessingMode": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.processingMode",
          "StringEquals": "face",
          "Next": "ProcessImagesFace"
        },
        {
          "Variable": "$.processingMode",
          "StringEquals": "bib",
          "Next": "ProcessImagesBib"
        }
      ],
      "Default": "ProcessImagesBib"
    },
    "ProcessImagesBib": {
      "Type": "Map",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "JSON"
        },
        "Parameters": {
          "Bucket.$": "$.manifestBucket",
          "Key.$": "$.manifestKey"
        }
      },
      "ItemSelector": {
        "eventId.$": "$.eventId",
        "requestId.$": "$.requestId",
        "fileId.$": "$$.Map.Item.Value.fileId"
      },
      "MaxConcurrency": 50,
      "ResultPath": null,
      "Label": "ProcessImagesBib",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "ExtractBibNumber",
        "States": {
          "ExtractBibNumber": {
            "Type": "Task",
            "Resource": "${EXTRACT_BIB_NUMBER_HANDLER_ARN}",
            "End": true
          }
        }
      },
      "Next": "ProcessingComplete"
    },
    "ProcessImagesFace": {
      "Type": "Map",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "JSON"
        },
        "Parameters": {
          "Bucket.$": "$.manifestBucket",
          "Key.$": "$.manifestKey"
        }
      },
      "ItemSelector": {
        "eventId.$": "$.eventId",
        "requestId.$": "$.requestId",
        "fileId.$": "$$.Map.Item.Value.fileId"
      },
      "MaxConcurrency": 50,
      "ToleratedFailurePercentage": 5,
      "ResultPath": null,
      "Label": "ProcessImagesFace",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "IndexFaces",
        "States": {
          "IndexFaces": {
            "Type": "Task",
            "Resource": "${INDEX_FACES_HANDLER_ARN}",
            "End": true
          }
        }
      },
      "Next": "ProcessingComplete"
    },
    "ProcessingComplete": {
      "Type": "Task",
      "Resource": "${IMAGE_PROCESSING_COMPLETION_HANDLER_ARN}",
      "End": true
    }
  }
}
